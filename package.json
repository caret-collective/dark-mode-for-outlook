{
	"name": "dark-mode-for-outlook",
	"version": "3.6.0",
	"description": "A browser extension/add-on that applies a better dark theme to Microsoft Outlook and removes ads",
	"packageManager": "bun@1.4.0",
	"keywords": [
		"browser-extension",
		"dark-mode",
		"dark-theme",
		"microsoft-outlook",
		"outlook",
		"sass",
		"webextension"
	],
	"main": "build.ts",
	"devDependencies": {
		"@types/archiver": "^8.0.0",
		"@types/bun": "^1.4.0",
		"@types/chrome": "^0.2.7",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.4.0",
		"archiver": "^5.3.2",
		"fs-extra": "^11.4.0",
		"nobs": "github:twocaretcat/NoBS",
		"replace-in-file": "^7.2.0",
		"sass": "^1.103.1",
		"sharp": "^0.32.6",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"start": "bun run build",
		"check": "tsc --noEmit",
		"build": "bun run check && bun run build.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caret-collective/dark-mode-for-outlook.git"
	},
	"author": {
		"name": "John Goodliff",
		"url": "https://johng.io"
	},
	"funding": [
		{
			"type": "individual",
			"url": "https://johng.io/funding"
		},
		{
			"type": "GitHub Sponsors",
			"url": "https://github.com/sponsors/twocaretcat"
		},
		{
			"type": "Patreon",
			"url": "https://patreon.com/twocaretcat"
		},
		{
			"type": "Brave Creators",
			"url": "https://publishers.basicattentiontoken.org/en/c/johng"
		}
	],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/caret-collective/dark-mode-for-outlook/issues"
	},
	"homepage": "https://github.com/caret-collective/dark-mode-for-outlook"
