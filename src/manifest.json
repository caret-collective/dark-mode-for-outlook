{
	"name": "__MSG_extensionName__",
	"short_name": "__MSG_extensionShortName__",
	"description": "__MSG_extensionDescription__",
	"version": "3.6",
	"default_locale": "en",
	"icons": {
		"128": "images/128.png",
		"64": "images/64.png",
		"48": "images/48.png",
		"32": "images/32.png",
		"16": "images/16.png"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": false
	},
	"content_scripts": [
		{
			"matches": [
				"*://outlook.live.com/*",
				"*://outlook.office.com/*",
				"*://outlook.office365.com/*",
				"*://support.office.live.com/*"
			],
			"css": [
				"styles/main.css"
			],
			"js": [
				"scripts/content.js"
			],
			"run_at": "document_start"
		},
		{
			"matches": [
				"*://support.office.live.com/*"
			],
			"css": [
				"styles/help.css"
			],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"background": {
		"scripts": [
			"scripts/background.js"
		],
		"service_worker": "scripts/background.js"
	},
	"permissions": [
		"scripting",
		"storage"
	],
	"optional_permissions": [
		"tabs"
	],
	"optional_host_permissions": [
		"*://*/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"styles/compose.css"
			],
			"matches": [
				"*://outlook.live.com/*",
				"*://outlook.office.com/*",
				"*://outlook.office365.com/*",
				"*://support.office.live.com/*"
			]
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "{cf211314-517c-470f-a589-02a4b272f7d5}"
		}
	},
	"manifest_version": 3
}
